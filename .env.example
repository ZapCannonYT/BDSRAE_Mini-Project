# Copy to .env and adjust. docker compose reads .env automatically.

# Replay speed of the producer: 1 = real time, 3600 = one hour of trips per second.
REPLAY_SPEEDUP=3600
# First and last month the producer replays (YYYY-MM).
REPLAY_START=2019-01
REPLAY_END=2019-01
# Number of Spark worker cores and memory per worker.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
